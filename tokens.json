{
  "$comment": "Design tokens of the Blätter layouts (website, archive, status page). Edit only this file, then run ./design build. Format: see README.md.",
  "colors": {
    "page": {
      "light": "#FFFFFF",
      "dark": { "default": "#161616", "text": "#FFFFFF" },
      "palm": "white",
      "use": "page, sticky headings, layers, fields"
    },
    "text": {
      "light": "#000000",
      "dark": "#E8E8E8",
      "palm": "black",
      "use": "running text, headings, titles, navigation",
      "note": "dark: not pure white, which glares"
    },
    "red": {
      "light": "#E51736",
      "dark": { "default": "#EC465D", "background": "#E51736", "border": "#E51736" },
      "palm": "red",
      "use": "logo, labels, active item, arrows",
      "note": "the red of the »Blätter« logo (no Pantone base); until 11/2026 the website used #E71835. Dark: the website's red-light for text (the logo red has only 3.9:1 on the dark page, text needs 4.5:1); backgrounds, frames and lines keep the logo red (3:1 is enough there)"
    },
    "red-light": {
      "light": "#EC465D",
      "palm": "red-light",
      "use": "website: hover of danger buttons"
    },
    "red-pale": {
      "light": "#FAD1D7",
      "palm": "red-pale",
      "use": "website: pale red backgrounds"
    },
    "link": {
      "light": "#086D9A",
      "dark": { "default": "#5DB4E3", "background": "#086D9A" },
      "palm": "blue",
      "use": "links, buttons",
      "note": "dark: own value (the website's blue-light #097EB2 has only 4.0:1 on the dark page); button backgrounds stay"
    },
    "link-hover": {
      "light": "#097EB2",
      "palm": "blue-light",
      "use": "website: hover of action buttons"
    },
    "focus": {
      "light": "#086D9A",
      "dark": { "default": "#5DB4E3", "background": "#086D9A" },
      "use": "focus outline",
      "note": "own: the website's --palm-color-focus #66AFE9 has only 2.3:1 on white"
    },
    "muted": {
      "light": "#6B6B6B",
      "dark": "#A3A3A3",
      "use": "meta lines, counts, footer",
      "note": "own: instead of grey-text #808080, which has only 3.9:1 as text"
    },
    "boundary": {
      "light": "#808080",
      "dark": { "default": "#808080", "text": "#A3A3A3" },
      "palm": "grey-text",
      "use": "borders of fields and buttons only (3:1 is enough, WCAG 1.4.11)"
    },
    "rule-strong": {
      "light": "#CCCCCC",
      "dark": "#4A4A4A",
      "palm": "grey-border",
      "use": "thick heading rules, layer frames"
    },
    "rule": {
      "light": "#E3E3E3",
      "dark": "#333333",
      "palm": "grey-dark",
      "use": "row separators, cover frames"
    },
    "surface": {
      "light": "#F2F2F2",
      "dark": "#262626",
      "palm": "grey",
      "use": "tiles, hover rows, notices, buttons"
    },
    "marker": {
      "light": "#FFE9A0",
      "dark": { "default": "#403500", "text": "#FFE9A0" },
      "use": "search words, highlighted text",
      "note": "own: the website's mark is #FFFF00; calmer and still 4.5:1 for links on it"
    }
  },
  "cover": {
    "$comment": "Hues of the 2026 covers, one per issue, rotating. Dark: mixed with 20 % white, so they keep 3:1 on the dark page. Only for bars, dots and large figures: some have less than 4.5:1 on white.",
    "petrol": { "light": "#007878", "covers": "6/2026" },
    "blue": { "light": "#0068A0", "covers": "2, 8/2026" },
    "violet": { "light": "#A02878", "covers": "3, 9/2026" },
    "green": { "light": "#609030", "covers": "4, 10/2026" },
    "red": { "light": "#C00840", "covers": "1, 7/2026" },
    "ochre": { "light": "#B87800", "covers": "5, 11/2026" }
  },
  "fonts": {
    "serif": { "stack": ["droid-serif", "Georgia", "Times New Roman", "serif"], "use": "running text" },
    "sans": { "stack": ["droid-sans", "Arial", "sans-serif"], "use": "navigation, meta lines, forms" },
    "display": { "stack": ["playfair", "Georgia", "serif"], "use": "headings, key figures" }
  },
  "contrast": {
    "$comment": "Pairs that must reach the minimum in both themes. The foreground counts as text unless \"as\" says border; the background as background. 4.5 for text, 3 for large text, focus outlines and component boundaries.",
    "pairs": [
      { "fg": "text", "bg": "page", "min": 4.5 },
      { "fg": "text", "bg": "surface", "min": 4.5 },
      { "fg": "muted", "bg": "page", "min": 4.5 },
      { "fg": "muted", "bg": "surface", "min": 4.5 },
      { "fg": "link", "bg": "page", "min": 4.5 },
      { "fg": "link", "bg": "surface", "min": 4.5 },
      { "fg": "link", "bg": "marker", "min": 4.5 },
      { "fg": "text", "bg": "marker", "min": 4.5 },
      { "fg": "red", "bg": "page", "min": 4.5 },
      { "fg": "red", "bg": "page", "min": 3, "as": "border" },
      { "fg": "focus", "bg": "page", "min": 3, "as": "border" },
      { "fg": "boundary", "bg": "page", "min": 3, "as": "border" },
      { "fg": "cover.*", "bg": "page", "min": 3 }
    ]
  }
}
