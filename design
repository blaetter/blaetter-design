#!/bin/sh
# Runs bin/tokens.php in Docker, so nothing besides Docker is needed.
# Usage: ./design build | ./design check | ./design copies [--update]
# `copies` runs on the host (plain sh): it compares the consumers' copies of dist/ (see bin/copies.sh).
set -eu
cd "$(dirname "$0")"
if [ "${1:-}" = "copies" ]; then
    shift
    exec sh bin/copies.sh "$@"
fi
exec docker run --rm -u "$(id -u):$(id -g)" -v "$PWD":/app -w /app php:8.4-cli-alpine php bin/tokens.php "$@"
